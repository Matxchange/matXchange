<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    html, body { margin: 0; padding: 0; }
    * { box-sizing: border-box; }
    input::placeholder { color: #A79F91; }
    input:focus { outline: none; }
  </style>
</helmet>

<div style="position:relative; min-height:100vh; width:100%; background: radial-gradient(circle at 88% -8%, rgba(217,164,65,0.20), transparent 42%), radial-gradient(circle at -8% 106%, rgba(138,90,46,0.12), transparent 40%), #FBF9F5; font-family:'IBM Plex Sans', sans-serif; overflow-x:hidden;">

  <!-- decorative motif: left -->
  <div style="position:absolute; left:-40px; top:12%; z-index:0; pointer-events:none;">
    <div style="position:relative; width:180px; height:180px;">
      <div style="position:absolute; inset:0; border-radius:50%; background:radial-gradient(circle at 45% 45%, rgba(95,138,90,0.15), transparent 62%);"></div>
      <div style="position:absolute; left:32px; top:32px; width:116px; height:116px; border-radius:50%; border:1.5px solid rgba(95,138,90,0.14);"></div>
      <svg width="58" height="58" viewBox="0 0 24 24" fill="none" style="position:absolute; left:61px; top:61px;"><path d="M12 21c-1.2-6.5 1-11.5 8.5-13.5C19.3 14.2 17 18.8 12 21z" fill="rgba(95,138,90,0.14)" stroke="#5F8A5A" stroke-width="1.4" stroke-linejoin="round"></path><path d="M12 21c0-4.3 1.6-8 5-10.2" stroke="#5F8A5A" stroke-width="1.4" stroke-linecap="round"></path></svg>
    </div>
  </div>

  <!-- decorative motif: right -->
  <div style="position:absolute; right:-50px; top:11%; z-index:0; pointer-events:none;">
    <div style="position:relative; width:220px; height:220px;">
      <div style="position:absolute; inset:0; border-radius:50%; background:radial-gradient(circle at 55% 38%, rgba(217,164,65,0.16), transparent 62%);"></div>
      <div style="position:absolute; left:38px; top:38px; width:144px; height:144px; border-radius:50%; border:1.5px dashed rgba(138,90,46,0.18);"></div>
      <svg width="78" height="78" viewBox="0 0 24 24" fill="none" style="position:absolute; left:71px; top:71px;">
        <path d="M4.5 10a7.5 7.5 0 0 1 12.8-3.7L20 9" stroke="#5F8A5A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M20 4.6V9.2h-4.6" stroke="#5F8A5A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M19.5 14a7.5 7.5 0 0 1-12.8 3.7L4 15" stroke="#D9A441" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M4 19.4V14.8h4.6" stroke="#D9A441" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
  </div>

  <!-- nav -->
  <div style="position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; padding: 24px 6vw;">
    <a href="/" style="text-decoration:none; display:flex; align-items:center;">
      <img src="assets/mx-logo.png" alt="Matxchange" style="height:30px; width:auto; display:block;"></img>
    </a>
  </div>

  <div style="position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; padding: 12px 20px 60px; min-height:calc(100vh - 78px); justify-content:center;">

    <!-- checking session -->
    <sc-if value="{{ checking }}" hint-placeholder-val="{{ true }}">
      <div style="text-align:center; color:#6B655C; font-size:15px;">Loading your account&#8230;</div>
    </sc-if>

    <!-- not logged in -->
    <sc-if value="{{ notLoggedIn }}" hint-placeholder-val="{{ false }}">
      <div style="width:100%; max-width:440px; background:#FFFFFF; border:1px solid #E7E1D6; border-radius:20px; box-shadow: 0 24px 60px -20px rgba(28,26,23,0.14); padding:clamp(32px,6vw,44px) clamp(24px,5vw,36px); text-align:center;">
        <h1 style="font-family:'Space Grotesk', sans-serif; font-size:24px; font-weight:600; color:#1C1A17; margin:0 0 12px;">You're signed out</h1>
        <p style="font-size:14.5px; line-height:1.6; color:#6B655C; margin:0 0 26px;">Sign in again to finish setting up your account.</p>
        <a href="/login" style="display:block; padding:14px; background:#1C1A17; color:#FBF9F5; border-radius:12px; font-size:15px; font-weight:600; text-decoration:none;">Go to login</a>
      </div>
    </sc-if>

    <!-- the form -->
    <sc-if value="{{ showForm }}" hint-placeholder-val="{{ false }}">

      <div style="text-align:center; margin-bottom:28px;">
        <h1 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(24px,5vw,32px); font-weight:600; color:#1C1A17; margin:0 0 8px; letter-spacing:-0.01em;">{{ greeting }}</h1>
        <div style="font-size:15px; color:#6B655C; max-width:380px; line-height:1.5;">Two more details and your account is ready.</div>
      </div>

      <div style="width:100%; max-width:480px; background:#FFFFFF; border:1px solid #E7E1D6; border-radius:20px; box-shadow: 0 24px 60px -20px rgba(28,26,23,0.14); padding:clamp(24px,5vw,36px) clamp(20px,5vw,32px);">

        <form style="display:flex; flex-direction:column; gap:20px;" onSubmit="{{ handleSubmit }}">

          <div>
            <label style="display:block; font-size:13px; font-weight:600; color:#1C1A17; margin-bottom:7px;">Phone number</label>
            <input type="tel" autocomplete="tel" value="{{ phone }}" onChange="{{ setPhone }}" placeholder="+254 7XX XXX XXX" style="width:100%; border:1px solid #E7E1D6; background:#F7F4EE; border-radius:12px; padding:13px 14px; font-size:15px; color:#1C1A17; font-family:'IBM Plex Sans', sans-serif;"></input>
            <div style="font-size:12.5px; color:#A79F91; margin-top:8px;">Used for M-Pesa payouts, and you can log in with it.</div>
          </div>

          <div>
            <label style="display:block; font-size:13px; font-weight:600; color:#1C1A17; margin-bottom:7px;">Company / Organization</label>
            <input type="text" value="{{ company }}" onChange="{{ setCompany }}" placeholder="e.g. Nairobi Recyclers Ltd" style="width:100%; border:1px solid #E7E1D6; background:#F7F4EE; border-radius:12px; padding:13px 14px; font-size:15px; color:#1C1A17; font-family:'IBM Plex Sans', sans-serif;"></input>
            <div style="font-size:12.5px; color:#A79F91; margin-top:8px;">Operating solo? Just use your own name.</div>
          </div>

          <div>
            <label style="display:block; font-size:13px; font-weight:600; color:#1C1A17; margin-bottom:12px;">What best describes you?</label>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
              <sc-for list="{{ roles }}" as="role" hint-placeholder-count="4">
                <button type="button" onClick="{{ role.onClick }}" style="{{ role.style }}">
                  <span style="{{ role.dotStyle }}"></span>
                  {{ role.label }}
                </button>
              </sc-for>
            </div>
          </div>

          <sc-if value="{{ hasError }}" hint-placeholder-val="{{ false }}">
            <div style="display:flex; align-items:flex-start; gap:9px; background:#FDF0EE; border:1px solid #F3D2CC; border-radius:11px; padding:11px 13px; font-size:13.5px; line-height:1.45; color:#9B3A28;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" style="flex-shrink:0; margin-top:1px;"><circle cx="12" cy="12" r="9" stroke="#C0503A" stroke-width="1.8"></circle><path d="M12 7.5v5" stroke="#C0503A" stroke-width="1.8" stroke-linecap="round"></path><circle cx="12" cy="16" r="1" fill="#C0503A"></circle></svg>
              <span>{{ error }}</span>
            </div>
          </sc-if>

          <button type="submit" style="{{ submitStyle }}">{{ submitLabel }}</button>
        </form>

      </div>
    </sc-if>

  </div>
</div>

</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  api = 'https://app.matxchange.co.ke';

  state = {
    checking: true,
    loggedIn: false,
    firstName: '',
    phone: '',
    company: '',
    role: 'Waste Generator',
    loading: false,
    error: '',
  };

  roleOptions = ['Waste Generator', 'Recycler', 'Aggregator', 'Buyer'];

  async componentDidMount() {
    try {
      const res = await fetch(this.api + '/api/method/matxchange.api.profile_status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'include',
        body: '{}',
      });
      const data = await res.json();
      const info = (data && data.message) || {};

      if (!info.logged_in) {
        this.setState({ checking: false, loggedIn: false });
        return;
      }

      // Already has a role and a phone - nothing to ask, go straight in.
      if (!info.needs_profile) {
        window.location.href = this.api + '/';
        return;
      }

      this.setState({
        checking: false,
        loggedIn: true,
        firstName: (info.first_name || info.full_name || '').split(' ')[0],
        phone: info.phone || '',
        role: info.role || 'Waste Generator',
      });
    } catch (err) {
      this.setState({ checking: false, loggedIn: false });
    }
  }

  setField = (field) => (e) => {
    const value = e.target.value;
    this.setState({ [field]: value, error: '' });
  };

  selectRole = (role) => this.setState({ role, error: '' });

  readError(data, status) {
    try {
      const msgs = JSON.parse(data._server_messages || '[]');
      const text = msgs.map(m => JSON.parse(m).message).join(' ');
      if (text) return text.replace(/<[^>]*>/g, '').trim();
    } catch (e) {}
    if (status === 403) return 'Your session expired. Please log in again.';
    return 'Could not save your details. Please try again.';
  }

  handleSubmit = async (e) => {
    e.preventDefault();

    const phone = (this.state.phone || '').trim();
    if (phone.replace(/[^0-9]/g, '').length < 9) {
      this.setState({ error: 'Enter a valid phone number.' });
      return;
    }

    this.setState({ loading: true, error: '' });

    try {
      const res = await fetch(this.api + '/api/method/matxchange.api.complete_profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          phone: phone,
          company: (this.state.company || '').trim(),
          role: this.state.role,
        }),
      });

      let data = {};
      try { data = await res.json(); } catch (err) {}

      if (!res.ok) throw new Error(this.readError(data, res.status));

      const home = (data.message && data.message.home) || '/';
      window.location.href = this.api + home;
    } catch (err) {
      this.setState({
        loading: false,
        error: err.message || 'Could not reach the server. Check your connection.',
      });
    }
  };

  baseBtnStyle = {
    display: 'flex', alignItems: 'center', gap: '9px', padding: '12px 14px',
    borderRadius: '11px', fontSize: '14px', fontWeight: 500,
    fontFamily: "'IBM Plex Sans', sans-serif", cursor: 'pointer', textAlign: 'left',
    transition: 'background 0.15s ease',
  };

  renderVals() {
    const loading = this.state.loading;

    const roles = this.roleOptions.map((label) => {
      const selected = label === this.state.role;
      return {
        label,
        onClick: () => this.selectRole(label),
        style: {
          ...this.baseBtnStyle,
          background: selected ? '#FBF3E6' : '#FFFFFF',
          border: selected ? '1.5px solid #D9A441' : '1.5px solid #E7E1D6',
          color: '#1C1A17',
        },
        dotStyle: {
          width: '8px', height: '8px', borderRadius: '50%', flexShrink: 0,
          background: selected ? 'linear-gradient(135deg,#8A5A2E,#D9A441)' : '#D8D2C4',
        },
      };
    });

    return {
      checking: this.state.checking,
      notLoggedIn: !this.state.checking && !this.state.loggedIn,
      showForm: !this.state.checking && this.state.loggedIn,
      greeting: this.state.firstName ? `Welcome, ${this.state.firstName}!` : 'Almost there',
      phone: this.state.phone,
      company: this.state.company,
      setPhone: this.setField('phone'),
      setCompany: this.setField('company'),
      roles,
      handleSubmit: this.handleSubmit,
      submitLabel: loading ? 'Saving\u2026' : 'Finish setup',
      submitStyle: {
        width: '100%',
        padding: '14px',
        background: loading ? '#4A453D' : '#1C1A17',
        color: '#FBF9F5',
        border: 'none',
        borderRadius: '12px',
        fontSize: '15px',
        fontWeight: 600,
        fontFamily: "'IBM Plex Sans', sans-serif",
        cursor: loading ? 'default' : 'pointer',
      },
      error: this.state.error,
      hasError: !!this.state.error,
    };
  }
}

</script>
</body>
</html>
